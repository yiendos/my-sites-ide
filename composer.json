{
    "name": "yiendos/my-sites-ide",
    "description": "local development environment",
    "type": "projects",
    "license": "mit",
    "autoload": {
        "psr-4": {
            "Yiendos\\MySitesIde\\": "_dev/console"
        }
    },
    "authors": [
        {
            "name": "yiendos",
            "email": "yiendos@sbmatrix.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "Packages/*/my-sites-ide-*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "post-autoload-dump": "Yiendos\\MySitesIde\\Plugins\\Discover::run"
    },
    "require": {
        "symfony/console": "7.3",
        "vlucas/phpdotenv": "^5.6",
        "laravel/installer": "^5.19",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    }
}
