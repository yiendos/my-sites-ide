JAVA_TOOL_OPTIONS=-Xss256k

# Active Scan concurrency for ide:zap-hud (via ZAP_WEBSWING_OPTS - see ZapHudCommand.php)
ZAP_ASCAN_THREADS_PER_HOST=2
ZAP_ASCAN_DELAY_MS=0

# DOM-based XSS (scanner 40026) spins up a real browser per test case and is
# uniquely expensive against DOM-heavy apps - confirmed live against Stockman:
# 929k+ requests, 91% still incomplete after ~2 hours, the sole bottleneck
# blocking every other rule in a full scan. LOW keeps a routine --full scan
# tractable; for deeper (MEDIUM/HIGH) DOM XSS coverage, scope a manual Active
# Scan to one page/request via ide:zap-hud instead of raising this site-wide.
ZAP_ASCAN_DOMXSS_STRENGTH=LOW
