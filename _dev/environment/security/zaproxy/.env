JAVA_TOOL_OPTIONS=-Xss256k

# Active Scan concurrency for ide:zap-hud (via ZAP_WEBSWING_OPTS - see ZapHudCommand.php)
ZAP_ASCAN_THREADS_PER_HOST=2
ZAP_ASCAN_DELAY_MS=0

# DOM-based XSS (scanner 40026) spins up a real browser per test case and is
# uniquely expensive against DOM-heavy apps - confirmed live against Stockman:
# 929k+ requests, 91% still incomplete after ~2 hours, the sole bottleneck
# blocking every other rule in a full scan. LOW keeps a routine --full scan
# tractable; for deeper (MEDIUM/HIGH) DOM XSS coverage, scope a manual Active
# Scan to one page/request via ide:zap-hud instead of raising this site-wide.
ZAP_ASCAN_DOMXSS_STRENGTH=LOW

# Database-specific injection rules to keep (comma-separated: mysql, postgresql,
# oracle, mssql, hypersonic, sqlite, mongodb); the rest are disabled. Their
# time-based probes are slow by design and can't find anything against a
# database the target doesn't use - confirmed live against a MySQL-only app,
# where they spent long stretches of a 75k-request scan at near-zero CPU.
# Empty runs them all, so a new target is never under-scanned by default -
# set it per user in the root .env. The generic SQL Injection rule always runs.
ZAP_ASCAN_DATABASES=

# How long ide:zap-scan --full waits for the active scan before giving up and
# generating a report anyway (the scan itself keeps running server-side
# regardless - this only controls the CLI's own patience). Confirmed live: a
# real full scan spanned ~18 minutes end to end even with DOM XSS capped to
# LOW above - 1800s gives real headroom without waiting forever on a
# genuinely hung scan.
ZAP_ASCAN_TIMEOUT_SECONDS=1800
