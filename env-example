NAMESPACE=my_sites
APP="fpm nginx apache mysql redis cli cron mailhog theia"
SERVERS="nginx apache"
SITE=default
MARIADB_DATABASE=yiendos
DOCKER_FILE=_dev/environment/images/local/Dockerfile
LARAVEL_INDEX=https://raw.githubusercontent.com/laravel/laravel/refs/heads/12.x/public/index.php
SQL_MODE=ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
# [php section configuration]
#default is to prevent all tricky functions
#however for development, this is less than ideal
#to remove these restrictions ensure that the root ./env
#has the following line present, and no fmaunctions are provided
PHP_DISABLE_FUNCTIONS=

# [OWASP ZAP configuration]
# Active Scan concurrency for ide:zap-hud, defaults live in zaproxy/.env (2 / 0ms)
# keep conservative, the zaproxy container is memory-capped - uncomment to override
#ZAP_ASCAN_THREADS_PER_HOST=2
#ZAP_ASCAN_DELAY_MS=0

# container resource caps, defaults live inline in zaproxy/docker-compose.yml
# (5g / 4 cores / cores 0-3) - uncomment and adjust to fit your machine
#ZAP_MEM_LIMIT=5g
#ZAP_CPUS=4
#ZAP_CPUSET=0,1,2,3

# the site nginx aliases onto the my-sites-ide network, so a browser proxied through
# ZAP can reach it (see the *.localhost proxy-bypass gotcha), default lives inline in
# servers/nginx/docker-compose.yml (default.test) - one hostname at a time, uncomment
# and set to whichever site you're scanning (requires `docker compose up -d nginx` to
# take effect, and that hostname must be in the target site's own nginx vhost server_name)
#ZAP_TARGET_ALIAS=default.test