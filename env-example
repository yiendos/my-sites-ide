NAMESPACE=my_sites
#PHP (fpm, cli), web servers, databases, redis and mailhog are plugins now (e.g. yiendos/my-sites-ide-preprocessors-php,
#-databases-mysql) - once installed the default ones start with ide:spark (and servers create their own
#site vhosts), so they needn't be listed here. Opt-in ones, such as theia (yiendos/my-sites-ide-editor-theia)
#and mariadb, still go here. Keep at least one entry - an empty APP starts every service, run-on-demand ones included
APP="theia"
SITE=default
#where each site's application code lives, inside Repos/<site>/ - deploy (the default),
#Sites for the older layout, or . for an app at the root of the repository. Plugins
#(composer, node, php, the web servers' new vhosts) all read it
IDE_APP_DIR=deploy
DOCKER_FILE=_dev/environment/images/local/Dockerfile
LARAVEL_INDEX=https://raw.githubusercontent.com/laravel/laravel/refs/heads/12.x/public/index.php
# [preprocessors-php plugin]
#fpm blocks a list of risky functions by default (exec, shell_exec, pcntl_*...)
#however for development, this is less than ideal - with the line below present
#and no functions provided, nothing is blocked. The cli container has its own
#list, PHP_CLI_DISABLE_FUNCTIONS, which blocks nothing by default
PHP_DISABLE_FUNCTIONS=

# [plugins]
# plugin settings live with each plugin - to copy a plugin's options in here,
# commented out, run: php my-sites-ide ide:plugin-env <vendor/package>

