NAMESPACE=my_sites
#PHP (fpm, cli), web servers and mailhog are plugins now (e.g. yiendos/my-sites-ide-preprocessors-php,
#-servers-nginx) - once installed they start with ide:spark (and servers create their own site vhosts),
#so they needn't be listed here
APP="mysql redis theia"
SITE=default
MARIADB_DATABASE=yiendos
DOCKER_FILE=_dev/environment/images/local/Dockerfile
LARAVEL_INDEX=https://raw.githubusercontent.com/laravel/laravel/refs/heads/12.x/public/index.php
SQL_MODE=ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION
# [preprocessors-php plugin]
#fpm blocks a list of risky functions by default (exec, shell_exec, pcntl_*...)
#however for development, this is less than ideal - with the line below present
#and no functions provided, nothing is blocked. The cli container has its own
#list, PHP_CLI_DISABLE_FUNCTIONS, which blocks nothing by default
PHP_DISABLE_FUNCTIONS=

# [plugins]
# plugin settings live with each plugin - to copy a plugin's options in here,
# commented out, run: php my-sites-ide ide:plugin-env <vendor/package>

